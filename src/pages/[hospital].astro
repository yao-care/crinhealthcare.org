---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import EmsBoard from '../components/charts/EmsBoard.svelte';
import EmsBoardV2 from '../components/charts/EmsBoardV2.svelte';
import { url } from '@utils/url';

export async function getStaticPaths() {
  const hospitals = await getCollection('hospitals');
  return hospitals.map((h) => ({
    params: { hospital: h.id },
    props: { hospital: h.data, hid: h.id },
  }));
}

const { hospital, hid } = Astro.props;
---

<Base
  title={`${hospital.name} · 韌性電網決策支援系統`}
  description={`${hospital.name} 韌性電網決策支援系統：供 → 儲 → 用 → 效，平時／戰時切換。`}
  ogImage={url(`/og/h/${hid}.png`)}
>
  {hospital.layout === 'v2'
    ? <EmsBoardV2 hospital={hospital} client:visible />
    : <EmsBoard hospital={hospital} client:visible />}
</Base>

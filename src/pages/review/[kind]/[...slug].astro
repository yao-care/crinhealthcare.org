---
// 內部審閱用未公開頁（單篇）：只產出 draft:true 的文章，帶 noindex、不進 sitemap、站上無連結。
// kind = news（新聞稿）或 insights（深度內容）。
// 正式發布時把 frontmatter 的 draft 改成 false —— 該篇就會從 /review/ 消失、
// 改由 /news/<id>/ 或 /insights/<id>/ 對外呈現（同一份 markdown，不必搬檔）。
import Article from '@layouts/Article.astro';
import { getCollection, render } from 'astro:content';
import { url } from '@utils/url';

export async function getStaticPaths() {
  const out = [];
  for (const kind of ['news', 'insights'] as const) {
    const entries = await getCollection(kind);
    for (const entry of entries.filter((e) => e.data.draft)) {
      out.push({ params: { kind, slug: entry.id }, props: { entry, kind } });
    }
  }
  return out;
}

const { entry, kind } = Astro.props;
const { Content } = await render(entry);
// news 與 insights 的 schema 不同（news 有 source/editorComment，insights 有 category），
// 這頁兩種都收 → 取聯集後各自以選用欄位讀取，避免在聯合型別上直接取屬性
const d = entry.data as {
  title: string;
  summary: string;
  publishDate: Date;
  tags: string[];
  source?: string;
  editorComment?: string;
  category?: string;
  internationalBenchmark?: {
    region: string;
    title: string;
    summary: string;
    sourceUrl: string;
    comparison: string;
  };
};

const categoryLabel: Record<string, string> = {
  policy: '政策解讀',
  guide: '知識指南',
  benchmark: '國際標竿',
};
const badge = kind === 'news' ? '新聞稿' : (categoryLabel[d.category ?? ''] ?? d.category ?? '');
---

<Article title={d.title} description={d.summary} publishDate={d.publishDate} tags={d.tags} noindex>
  <p class="notice">
    <strong>內部審閱用，尚未發布。</strong>
    本文標記為草稿，不在網站文章列表、RSS 與 sitemap 中，搜尋引擎不收錄。請勿轉發到協會以外。
    <a href={url('/review/')}>回審閱清單</a>
  </p>

  <div class="insight-category">
    <span class="category-badge">{badge}</span>
    {kind === 'news' && d.source && <span class="src">來源：{d.source}</span>}
  </div>

  <div class="insight-summary">
    <p>{d.summary}</p>
  </div>

  <Content />

  {d.editorComment && (
    <aside class="editor" aria-label="編輯觀點">
      <h3 class="editor__title">編輯觀點</h3>
      <p>{d.editorComment}</p>
    </aside>
  )}

  {d.internationalBenchmark && (
    <aside class="benchmark" aria-label="國際標竿資料">
      <h3 class="benchmark__title">國際標竿：{d.internationalBenchmark.region}</h3>
      <div class="benchmark__body">
        <h4 class="benchmark__subtitle">{d.internationalBenchmark.title}</h4>
        <p class="benchmark__summary">{d.internationalBenchmark.summary}</p>
        <p class="benchmark__comparison">{d.internationalBenchmark.comparison}</p>
        <a
          href={d.internationalBenchmark.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="benchmark__link"
        >
          閱讀原始資料 ↗
        </a>
      </div>
    </aside>
  )}
</Article>

<style>
  .notice {
    background-color: var(--color-notice-bg);
    border: 1px solid var(--color-notice-border);
    border-left: 4px solid var(--color-notice-accent);
    color: var(--color-notice-text);
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    line-height: var(--leading-loose);
    margin-bottom: var(--space-2xl);
  }

  .notice a {
    color: var(--color-notice-text);
    font-weight: 600;
  }

  .insight-category {
    margin-bottom: var(--space-lg);
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .category-badge {
    padding: var(--space-xs) var(--space-md);
    background-color: var(--color-primary-pale);
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: 9999px;
  }

  .src {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .insight-summary {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-loose);
    border-left: 4px solid var(--color-primary);
    padding-left: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }

  .editor {
    margin-top: var(--space-2xl);
    padding: var(--space-lg) var(--space-xl);
    background-color: var(--color-primary-pale);
    border-radius: var(--radius-md);
  }

  .editor__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .benchmark {
    margin-top: var(--space-3xl);
    padding: var(--space-xl);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    border-top: 4px solid var(--color-chart-4);
  }

  .benchmark__title {
    font-size: var(--text-lg);
    font-family: var(--font-heading);
    font-weight: 700;
    margin-bottom: var(--space-lg);
  }

  .benchmark__subtitle {
    font-size: var(--text-base);
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  .benchmark__summary {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-sm);
  }

  .benchmark__comparison {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-lg);
    font-style: italic;
  }

  .benchmark__link {
    font-size: var(--text-sm);
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
  }
</style>
